# Backend
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://gridwatch:gridwatch@localhost:5432/gridwatch
REDIS_URL=redis://localhost:6379/0

CARBON_INTENSITY_BASE_URL=https://api.carbonintensity.org.uk
OCTOPUS_BASE_URL=https://api.octopus.energy/v1
OCTOPUS_DEFAULT_GSP_REGION=C
OCTOPUS_DEFAULT_PRODUCT_CODE=

CACHE_TTL_CARBON_SECONDS=60
CACHE_TTL_PRICE_SECONDS=120
SNAPSHOT_INTERVAL_SECONDS=1800

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000
